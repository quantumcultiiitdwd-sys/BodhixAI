# Public URL used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). All three are required;
# without them the form returns a clear "not configured" error instead of faking success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=team@your-domain.com
CONTACT_FROM_EMAIL="BodhixAI Website <website@your-domain.com>"
